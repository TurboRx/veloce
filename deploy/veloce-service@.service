# Generated by deploy/generate.sh from deploy/config.env, don't edit.
#
# Service cluster %i of 1, run as veloce-service@0 to veloce-service@N.
# Reads veloce.toml from /opt/veloce and applies migrations on every start.
[Unit]
Description=Veloce cluster %i
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/opt/veloce
ExecStartPre=/opt/veloce/veloce database migrate up
ExecStart=/bin/sh -c 'exec /opt/veloce/veloce server'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
