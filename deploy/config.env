# Production setup for Veloce deployment.
# After editing, run deploy/generate.sh and commit, then deploy/server.sh to apply.

# Number of service clusters. Must divide 10000 (1, 2, 4, 5, 8, 10, ...).
CLUSTER_COUNT=1
# Cluster N listens on SERVICE_BASE_PORT + N.
SERVICE_BASE_PORT=8080

WEB_DOMAIN=veloce.app
API_DOMAIN=api.veloce.app

# Paths on the remote server
WEB_DIR=/var/www/veloce-web
SERVICE_DIR=/opt/veloce
NGINX_CONF_PATH=/etc/nginx/sites-enabled/veloce

# CPU architecture of the server (amd64, arm64)
SERVICE_ARCH=amd64

# Maximum request body size accepted by the API
API_MAX_BODY_SIZE=10M

# Baked into the web build
NEXT_PUBLIC_API_URL=https://api.veloce.app
